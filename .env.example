# =============================================================================
# .env.example — только секреты и per-deployment настройки.
#
# Все остальные параметры (БД-креды, хосты, порты, TTL, флаги) имеют разумные
# дефолты в docker-compose.yml и core/settings.py. БД-креды НЕ являются
# чувствительными данными, так как контейнер postgres не имеет внешнего доступа
# (нет port mapping) — оставляем дефолт `postgres`/`postgres`/`postgres` в compose.
# =============================================================================

# === SECRETS (обязательно изменить в production!) ===

# Telegram bot token от @BotFather
BOT_TOKEN=your_bot_token_here

# JWT секрет ≥32 символа.
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=REPLACE_WITH_SECURE_KEY_MIN_32_CHARS

# Redis пароль (для аутентификации сессий и replay-protection).
# ОБЯЗАТЕЛЬНО задать (docker-compose упадёт с ошибкой при пустом).
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=

# === DEPLOYMENT IDENTITY (обязательно для конкретного развёртывания) ===

# ID Telegram-канала для мониторинга. Должен начинаться с -100
CHANNEL_ID=

# === DEPLOYMENT URLS (опционально, для Telegram WebApp) ===

# Публичный HTTPS-URL приложения (для BotFather webapp configuration)
WEBAPP_URL=
# Куда отправлять не-Telegram трафик при включённой валидации
REDIRECT_URL=

# === OPTIONAL OVERRIDES (раскомментировать чтобы оверридить дефолт) ===

# Default `True`. Установите `False` для dev-режима (без проверки Telegram InitData)
#TELEGRAM_VALIDATION_ENABLED=True

# Порог фуззи-матча в StreetMatcher (0-1). Default 0.67. Текущая прод-настройка 0.75.
#ENTITY_SIMILARITY_THRESHOLD=0.75

# Радиус псевдо-пересечений (м) в process_candidates SQL. Default 150.0
#PSEUDO_INTERSECTION_RADIUS_METERS=150

# Уровень логирования parser/app (DEBUG/INFO/WARNING/ERROR). Default INFO
#LOG_LEVEL=INFO
# Формат логов: json (production) или text (development). Default json
#LOG_FORMAT=json

# SOCKS5 прокси (если pyrogram требует обход блокировок Telegram API)
#SOCKS5_HOST=
#PROXY_PORT=1080
#PROXY_SCHEME=socks5

# Перепиш Postgres пароль (если хочется изменить дефолт `postgres`)
#POSTGRES_PASSWORD=postgres
