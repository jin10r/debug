# PostgreSQL Configuration
POSTGRES_PASSWORD=postgres

# Application Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
CHANNEL_ID=      #-1002050105527

# Web Application
APP_HOST=0.0.0.0
APP_PORT=8080

# Optional: WebApp URL and redirect (for production)
WEBAPP_URL=https://yourdomain.com
REDIRECT_URL=https://t.me/your_bot

# JWT Configuration (REQUIRED: Generate a secure key!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Must be at least 32 characters. DO NOT use default values!
JWT_SECRET=REPLACE_WITH_SECURE_KEY_MIN_32_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Redis Configuration (for session storage and replay protection)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# Feature flags (optional)
TELEGRAM_VALIDATION_ENABLED=True #True/False

# Parser configuration (Docker container path)
EVENTS_MEDIA_DIR=/app/media/events
