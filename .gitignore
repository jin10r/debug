# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
.venv-train/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment (all secrets here)
.env
.env.local
.env.*.local
*.local

# Secrets directory (deprecated - use .env instead)
secrets/

# Logs
*.log
logs/

# Cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
arms_cache/

# Editor
.qoder/
.windsurf/

# Session files
*.session
*.session-journal

# Secrets (keep structure, not content)
secrets/*.txt
!secrets/.gitkeep

# Test data
tests/test_messages.txt

# Documentation (whitelist-style: by default all *.md ignored; allow only
# living docs in docs/ and developer rules CLAUDE.md)
*.md
!CLAUDE.md
!web/CLAUDE.md
!docs/**/*.md
!training/REPORT_retrain.md
!ner_training_gpu/README.md
pg_plan3.txt

# Archived migration scripts and docs
postgres/migrations/ARCHIVE/
docs/ARCHIVE/

# Misc
.DS_Store
Thumbs.db

# ML Models (large files — run scripts/export_onnx_model.py to regenerate).
# Use models/* (not models/) so specific subdirs can be re-included — git
# cannot un-ignore a child if the parent directory itself is excluded.
models/*
!models/.gitkeep
!models/gliner_onnx/
!models/ner_loc_onnx/
rubert-tiny2-onnx/

# NER training intermediates (committed: training/*.py; ignored: data/checkpoints)
training/data/
training/output/
training/.cache/

# Frontend build artifacts
web/node_modules/
web/dist/

# Runtime media uploads
media/
logs
# Build / profiling artifacts
optimization_results.json

# Training data artifacts (large, generated locally — not versioned)
train_data/
nnew_events_export.csv
