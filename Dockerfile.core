# Dockerfile.core — API сервер (multi-stage build)
# Stage 1: builder — установка зависимостей
FROM python:3.11.10-slim-bookworm AS builder

RUN --mount=type=cache,target=/var/cache/apt,id=core-apt \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --user --no-cache-dir -r requirements.txt && \
    find /root/.local -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /root/.local -type f -name "*.pyc" -delete && \
    find /root/.local -type f -name "*.pyo" -delete && \
    find /root/.local -type f -name "*.md" -delete

# Stage 2: runtime — минимальный образ без gcc, pip, setuptools
FROM python:3.11.10-slim-bookworm

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Only runtime apt deps (libpq for asyncpg)
RUN --mount=type=cache,target=/var/cache/apt,id=core-runtime \
    apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /root/.local /home/appuser/.local
ENV PATH="/home/appuser/.local/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Copy application files
COPY core/ ./core/
COPY main.py .

# Remove .pyc from app code too
RUN find /app -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /app -type f -name "*.pyc" -delete && \
    find /app -type f -name "*.pyo" -delete && \
    pip uninstall -y pip setuptools wheel 2>/dev/null || true

# Create media directory with correct ownership
RUN mkdir -p /app/media/events && chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

CMD ["python", "main.py"]
