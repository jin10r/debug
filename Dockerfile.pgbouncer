# =============================================================================
# PgBouncer — lightweight connection pooler for PostgreSQL
# =============================================================================

FROM bitnami/pgbouncer:1.23.1

# Copy custom configuration
COPY pgbouncer/pgbouncer.ini /bitnami/pgbouncer/conf/pgbouncer.ini
COPY pgbouncer/userlist.txt /bitnami/pgbouncer/conf/userlist.txt

# Expose PgBouncer port
EXPOSE 6432
