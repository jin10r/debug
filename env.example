# =============================================================================
#               CREDENTIALS
#
# Всё остальное (DB-параметры, калибровка матчера, прокси, логирование, CORS,
# JWT TTL, лимиты парсера) централизовано в `core/settings.py`
# как hardcoded defaults в соответствующих @dataclass. Чтобы поменять — правь
# core/settings.py, не env
# =============================================================================

# === SECRETS (обязательно изменить в production!) ===

# Telegram bot token от @BotFather
BOT_TOKEN=your_bot_token_here

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=postgres

# JWT_SECRET — стабильный секрет подписи JWT (настоятельно рекомендуется
# для production). Если НЕ задан, core генерирует эфемерный секрет при старте:
#   • все выданные токены инвалидируются при каждом рестарте core;
#   • при нескольких репликах core секреты разойдутся и верификация сломается.
# Требования: ≥32 символов, НЕ плейсхолдер. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# или: openssl rand -base64 48
# JWT_SECRET в env НЕ обязателен — если не задан, settings.py автогенерирует
# эфемерный секрет. Задайте ТОЛЬКО если нужен стабильный секрет между рестартами
# или общий на несколько реплик core (≥32 символов, НЕ плейсхолдер).
JWT_SECRET=

# === DEPLOYMENT URLS / WEBAPP (для Telegram Mini App) ===

# Публичный HTTPS-URL приложения. Нужен для production Mini App: бот вставляет
# его в кнопку «Открыть приложение», этот же URL задаётся в @BotFather.
# Для локальной проверки в браузере можно оставить пустым.
WEBAPP_URL=

# Режим доступа к приложению:
#   True  — СТРОГИЙ РЕЖИМ: доступ только из Telegram WebView (production)
#           Любой другой webview → редирект на REDIRECT_URL
#           Обязательная валидация initData с HMAC-SHA256 проверкой
#   False — РЕЖИМ РАЗРАБОТКИ: доступ из любого webview
#           НЕ ИСПОЛЬЗУЙТЕ В PRODUCTION!
# Принимаемые значения: True/False, 1/0, yes/no, on/off.
TELEGRAM_VALIDATION_ENABLED=True

# Куда редиректить пользователей при попытке доступа не из Telegram WebView
# (когда TELEGRAM_VALIDATION_ENABLED=True)
# Рекомендуется указывать ссылку на вашего бота: https://t.me/your_bot
REDIRECT_URL=https://t.me/your_bot

# === OPTIONAL OVERRIDES ===

# Порог схожести для лексического матчера
ENTITY_SIMILARITY_THRESHOLD=0.78

# === NOMINATIM (геокодер, отдельный контейнер) ===

# Пароль для подключения к БД Nominatim. По умолчанию qaIACxO6wMR3.
# Если меняете — должен совпадать с NOMINATIM_PASSWORD в docker-compose сервиса nominatim.
# NOMINATIM_PASSWORD=qaIACxO6wMR3
# Включить/выключить Nominatim fallback в processor.
# NOMINATIM_ENABLED=true

# === OLLAMA (LLM fallback для гео-резолвинга) ===

# Адрес Ollama сервера на хосте. По умолчанию http://host.docker.internal:11434
# Если Ollama не запущена — приложение продолжает работу без ошибок.
OLLAMA_HOST=http://192.168.1.100:11434

# === PROXY (если Telegram заблокирован в среде развёртывания) ===
# SOCKS5/HTTP прокси для подключения к Telegram (core и parser).
# Оставьте пустым если Telegram доступен напрямую.
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
# PROXY_SCHEME=socks5

